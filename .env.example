# Copy this file to `.env` at the repo root and fill in the values before
# running `docker compose up`. docker-compose substitutes ${VAR} references
# in docker-compose.yml from this file automatically.

# REQUIRED — JWT signing secret used by flask-jwt-extended. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional — defaults shown
MONGO_DB_NAME=todoapp

# Optional — override the API base URL the frontend is built against.
# Leave commented to use the default `http://localhost:5000` (which matches
# the host-published backend port in docker-compose.yml).
# VITE_API_BASE_URL=http://localhost:5000
